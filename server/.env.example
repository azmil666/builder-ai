# Server Network Port (Default: 3000)
PORT=3000

# MongoDB Connection String (Required)
MONGODB_URI=mongodb://127.0.0.1:27017/builder-ai

# Allowed CORS Origins (Comma-separated, Required in Production)
ORIGINS=http://localhost:5173,http://localhost:3000

# Cryptographically Secure JWT Signing Secret (Required, >= 32 characters)
JWT_SECRET=your-secure-random-jwt-secret-here

# OpenRouter API Key for AI Generation (Required)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter Model Identifier (Optional, Default: openrouter/free)
OPENROUTER_MODEL=openrouter/free

# Maximum Concurrent File Generation Requests (Optional, Default: 6)
AI_MAX_CONCURRENCY=6

# Node Environment Mode (development | production)
NODE_ENV=development

